#!/bin/sh
# SPDX-FileCopyrightText: 2026 Espressif Systems (Shanghai) CO LTD
# SPDX-License-Identifier: CC0-1.0

CONFIG=/etc/esp-example-target.conf

[ -r "$CONFIG" ] && . "$CONFIG"

if [ -n "${ESP_EXAMPLE_NETWORK_INTERFACE:-}" ]; then
	ip link set "$ESP_EXAMPLE_NETWORK_INTERFACE" up
	udhcpc -b -q -t 1 -T 1 -i "$ESP_EXAMPLE_NETWORK_INTERFACE"
fi

address=$(
	ip -4 addr show dev "$ESP_EXAMPLE_NETWORK_INTERFACE" 2>/dev/null |
		awk '/inet / { split($2, field, "/"); print field[1]; exit }'
)

if [ -n "$address" ]; then
	printf 'ESP system dashboard: http://%s:8080/\n' "$address"
else
	printf 'ESP system dashboard: waiting for an address on %s\n' \
		"${ESP_EXAMPLE_NETWORK_INTERFACE:-the target interface}"
fi

exec /usr/bin/esp-system-dashboard
