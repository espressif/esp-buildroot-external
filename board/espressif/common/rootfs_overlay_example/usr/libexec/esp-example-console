CONFIG=/etc/esp-example-target.conf

[ -r "$CONFIG" ] || exit 1
. "$CONFIG"

exec /sbin/getty -n -l /bin/sh \
	"${ESP_EXAMPLE_CONSOLE_BAUD}" \
	"${ESP_EXAMPLE_CONSOLE_DEVICE}" \
	"${ESP_EXAMPLE_CONSOLE_TERM}"
