#!/bin/sh
# SPDX-FileCopyrightText: 2026 Espressif Systems (Shanghai) CO LTD
# SPDX-License-Identifier: CC0-1.0

CONFIG=/etc/esp-example.conf
PID_FILE=/run/esp-example.pid

[ -r "$CONFIG" ] || exit 0
. "$CONFIG"

run_example()
{
	set -- ${ESP_EXAMPLE_ARGS:-}
	if [ "${ESP_EXAMPLE_BACKGROUND:-no}" = "yes" ]; then
		"$ESP_EXAMPLE_COMMAND" "$@" >/dev/console 2>&1 &
		echo "$!" > "$PID_FILE"
	else
		"$ESP_EXAMPLE_COMMAND" "$@" >/dev/console 2>&1
	fi
}

case "$1" in
	start)
		printf 'Starting ESP Linux example: %s\n' \
			"${ESP_EXAMPLE_ID:-$ESP_EXAMPLE_COMMAND}" >/dev/console
		run_example
		;;
	stop)
		if [ -r "$PID_FILE" ]; then
			kill "$(cat "$PID_FILE")" 2>/dev/null || true
			rm -f "$PID_FILE"
		fi
		;;
	restart)
		"$0" stop
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}" >&2
		exit 1
		;;
esac
